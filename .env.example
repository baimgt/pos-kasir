# =============================================================================
# ENVIRONMENT VARIABLES - POS KASIR APPLICATION
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (SERVER ONLY - Never expose to client)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://baimgt24_db_user:baimyoutube123@cluster0.sgys25x.mongodb.net
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/pos-kasir

# -----------------------------------------------------------------------------
# AUTHENTICATION (SERVER ONLY - Never expose to client)
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY (SERVER ONLY - Never expose to client)
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here
MIDTRANS_MERCHANT_ID=your-merchant-id
# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION=false

# -----------------------------------------------------------------------------
# APPLICATION URL
# -----------------------------------------------------------------------------
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MIDTRANS CLIENT KEY (PUBLIC - Safe to expose to client)
# These variables with NEXT_PUBLIC_ prefix are accessible in browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 1. Variables WITHOUT 'NEXT_PUBLIC_' prefix are SERVER-ONLY
#    They are NEVER sent to the browser
#
# 2. Variables WITH 'NEXT_PUBLIC_' prefix are PUBLIC
#    They ARE accessible in the browser JavaScript
#
# 3. SERVER-ONLY variables (NEVER expose to client):
#    - MONGODB_URI (contains credentials)
#    - NEXTAUTH_SECRET (signing secret)
#    - JWT_SECRET (signing secret)
#    - MIDTRANS_SERVER_KEY (payment gateway secret)
#    - MIDTRANS_MERCHANT_ID
#
# 4. PUBLIC variables (safe to expose):
#    - NEXT_PUBLIC_APP_URL
#    - NEXT_PUBLIC_MIDTRANS_CLIENT_KEY (Midtrans client key for Snap.js)
#    - NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION
# =============================================================================
